# ZeroDue — environment variables
# Copy to `.env` at the repo root (api reads it) and to `apps/web/.env.local` (web reads NEXT_PUBLIC_*).
# Never commit real values.

# ─────────────────────────── apps/api (NestJS) ───────────────────────────
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://zerodue:zerodue@localhost:5432/zerodue?schema=public

# Origin allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# JWT access secret signs access tokens; refresh secret keys the HMAC that hashes refresh tokens.
# Generate each with: openssl rand -base64 48 (min 16 chars enforced)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Allow new accounts to register (set to false once your account exists)
ALLOW_SIGNUP=true

# Refresh cookie `Secure` flag. Must be true behind HTTPS; false for plain http://localhost
COOKIE_SECURE=false

# Max login/register attempts per minute per IP
AUTH_RATE_LIMIT=10

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set true when the API sits behind one reverse proxy (Caddy, nginx) so limits count each client, not the proxy
TRUST_PROXY=false

# Background jobs (reminders every minute, due dates daily). Set false on any extra API instance.
SCHEDULER=true

# Device-token auth for SMS ingest (Flutter companion)
DEVICE_PAIRING_CODE_TTL_SECONDS=300
# The address the phone app should call (shown in the pairing QR). Defaults to the address the
# pairing request came in on, which is wrong behind some proxies.
PUBLIC_API_URL=
# Max payment messages one client may send per minute
INGEST_RATE_LIMIT=60

# ─────────────────────────── apps/web (Next.js) ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Same value as VAPID_PUBLIC_KEY above
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────── apps/mobile (Flutter) ───────────────────────
# Not read from .env — passed at build/run time:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:4000
#   (10.0.2.2 = host machine from the Android emulator; use your LAN IP on a real device)
# API_BASE_URL=http://10.0.2.2:4000
