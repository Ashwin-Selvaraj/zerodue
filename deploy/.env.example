# Copy to deploy/.env and fill in. Never commit the real file.

# Two names on one domain, both pointing at this machine (DNS A records).
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48   (use two different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# After you have created your account, set this to false and run `up -d` again.
ALLOW_SIGNUP=true

# Optional: push notifications. npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
